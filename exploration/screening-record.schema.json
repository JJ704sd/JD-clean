{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/screening-record.schema.json",
  "title": "Human-reviewed resume screening record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "screening_record_id",
    "candidate_id",
    "role",
    "jd_version",
    "rubric_version",
    "screening_status",
    "recommendation",
    "evidence",
    "uncertainties",
    "interview_probes",
    "sensitive_attributes_used",
    "human_review",
    "automation_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "screening_record_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Use a pseudonymous internal identifier rather than a candidate name."
    },
    "role": {
      "enum": [
        "senior-fullstack-engineer",
        "fullstack-development-intern"
      ]
    },
    "jd_version": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "screening_status": {
      "enum": [
        "non_final",
        "human_finalized"
      ]
    },
    "recommendation": {
      "enum": [
        "advance_pending_human",
        "second_review",
        "do_not_advance_pending_human"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertaintyItem"
      }
    },
    "interview_probes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitive_attributes_used": {
      "const": false
    },
    "human_review": {
      "$ref": "#/$defs/humanReview"
    },
    "automation_actions": {
      "type": "array",
      "maxItems": 0,
      "description": "The screening Skill must not perform invitations, rejections, or final ATS mutations."
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "criterion_name",
        "state",
        "excerpt",
        "location",
        "rationale",
        "confidence"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "supported",
            "not_evidenced",
            "conflicting"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "supported",
                  "conflicting"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "excerpt": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "uncertaintyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "requires_second_review"
      ],
      "properties": {
        "code": {
          "enum": [
            "U01_PARSE_QUALITY",
            "U02_MUST_HAVE_MISSING",
            "U03_CONFLICTING_FACTS",
            "U04_CONTRIBUTION_UNCLEAR",
            "U05_TRANSFERABILITY",
            "U06_BOUNDARY_CASE",
            "U07_BIAS_OR_PROXY",
            "U08_DIMENSION_CONFLICT",
            "U09_ROLE_AMBIGUITY",
            "U10_RUBRIC_AMBIGUITY"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requires_second_review": {
          "const": true
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level_1_required",
        "level_1_reviewer",
        "level_1_decision",
        "level_2_required",
        "level_2_reason_codes",
        "level_2_reviewer",
        "level_2_decision",
        "resolution_owner",
        "resolution"
      ],
      "properties": {
        "level_1_required": {
          "const": true
        },
        "level_1_reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_1_decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_2_required": {
          "type": "boolean"
        },
        "level_2_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^U(0[1-9]|10)_[A-Z_]+$"
          }
        },
        "level_2_reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_2_decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommendation": {
            "const": "second_review"
          }
        },
        "required": [
          "recommendation"
        ]
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "level_2_required": {
                "const": true
              },
              "level_2_reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uncertainties": {
            "minItems": 1
          }
        },
        "required": [
          "uncertainties"
        ]
      },
      "then": {
        "properties": {
          "recommendation": {
            "const": "second_review"
          },
          "human_review": {
            "properties": {
              "level_2_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "screening_status": {
            "const": "human_finalized"
          }
        },
        "required": [
          "screening_status"
        ]
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "level_1_reviewer": {
                "type": "string",
                "minLength": 1
              },
              "level_1_decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_review": {
            "properties": {
              "level_2_required": {
                "const": true
              }
            },
            "required": [
              "level_2_required"
            ]
          }
        },
        "required": [
          "human_review"
        ]
      },
      "then": {
        "properties": {
          "recommendation": {
            "const": "second_review"
          },
          "human_review": {
            "properties": {
              "level_2_reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "screening_status": {
                "const": "human_finalized"
              }
            },
            "required": [
              "screening_status"
            ]
          },
          {
            "properties": {
              "human_review": {
                "properties": {
                  "level_2_required": {
                    "const": true
                  }
                },
                "required": [
                  "level_2_required"
                ]
              }
            },
            "required": [
              "human_review"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "level_2_reviewer": {
                "type": "string",
                "minLength": 1
              },
              "level_2_decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
